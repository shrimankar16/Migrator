# ── Source: MySQL ──────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=your_db

# ── Target: PostgreSQL ─────────────────────────────────────────────────────────
# Format: postgres://<user>:<password>@<host>:<port>/<database>
PG_URL=postgres://postgres:postgres@localhost:5432/target

# ── Auth ───────────────────────────────────────────────────────────────────────
# Must be ≥ 16 characters. Pass as: x-api-key: <value>
ADMIN_API_KEY=xuHs2ZpIEqUaAY1imokC0Mvw3yO5nDK8

# ── Migration tuning ───────────────────────────────────────────────────────────
# Rows per batch (100–50000). Larger = faster but more memory.
BATCH_SIZE=5000

# Comma-separated list of tables to migrate (FK-parent-first order).
# Leave empty to migrate ALL tables in alphabetical order.
TABLES=users,documents

# Incremental sync column per table. Must be NOT NULL and updated on every row change.
# Example: orders:updated_at,users:updated_at
SYNC_COLUMNS=

# Run incremental sync every N minutes automatically. 0 = manual only.
SYNC_INTERVAL_MIN=0

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000

# ── Encryption at rest (pgcrypto) ──────────────────────────────────────────────
# Strong passphrase used by pgcrypto pgp_sym_encrypt to encrypt sensitive columns
# before they are stored in Postgres. Must be ≥ 16 characters.
# The key is NEVER written to the database — only kept in process memory.
# IMPORTANT: back this up securely. Losing the key = losing access to the data.
PG_ENCRYPTION_KEY=Ch4ng3M3T0AStr0ngS3cr3tK3y!!2026

# Columns to encrypt at rest, per table. Format: table:column,table:column
# - users.email    → PII, encrypted so raw email is never on disk in Postgres
# - documents.payload → BLOB data, encrypted at rest
ENCRYPT_COLUMNS=users:email,documents:payload
