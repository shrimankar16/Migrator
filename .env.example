MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=your_db
PG_URL=postgres://postgres:postgres@localhost:5432/target
ADMIN_API_KEY=use-a-long-random-string-here
BATCH_SIZE=5000
# Parent tables first (foreign-key order). Empty = all tables, alphabetical.
TABLES=
# Incremental sync column per table. Must be NOT NULL and updated on every change. Example: orders:updated_at
SYNC_COLUMNS=
# 0 = no automatic sync
SYNC_INTERVAL_MIN=0
PORT=3000
# Strong passphrase for pgcrypto column encryption (≥ 16 chars). Leave empty to disable.
PG_ENCRYPTION_KEY=
# Columns to encrypt at rest. Format: table:column,table:column. Example: users:email,documents:payload
ENCRYPT_COLUMNS=
